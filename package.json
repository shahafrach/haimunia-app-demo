{
  "name": "haimunia-app",
  "private": true,
  "version": "1.0.0",
  "description": "Offline-first Hebrew training log and opt-in Supabase community PWA. Production remains build-free; the Supabase browser client is vendored for static hosting.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync-version": "node scripts/sync-version.mjs",
    "check-version": "node scripts/sync-version.mjs --check",
    "check-vendor-version": "node scripts/check-vendored-supabase-version.mjs",
    "smoke-test-anon-key": "node scripts/smoke-test-anon-key.mjs",
    "setup-hooks": "node scripts/setup-hooks.mjs",
    "test": "node --test",
    "check-deploy-readiness": "node scripts/check-deploy-readiness.mjs",
    "check:drift": "node scripts/check-migration-drift.mjs",
    "check:versions": "node scripts/check-migration-versions.mjs",
    "push:prod": "node scripts/push-migrations.mjs",
    "check:immutable": "node scripts/check-migration-immutability.mjs",
    "backup:storage": "node scripts/backup-storage.mjs"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^30.1.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0"
  }
}
